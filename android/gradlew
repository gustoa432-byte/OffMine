#!/bin/sh
#
# Gradle wrapper script for PocketCore Android build
#
set -e

GRADLE_APP_HOME="$(cd -P -- "$(dirname -- "$0")" && pwd -P)"
APP_HOME="$GRADLE_APP_HOME"
APP_BASE_NAME="$(basename "$0")"

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -f "$CLASSPATH" ]; then
    exec java -Xmx4096m -jar "$CLASSPATH" "$@"
else
    # Fallback to system gradle if wrapper jar is being downloaded by CI
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    else
        echo "Running gradlew: gradle wrapper jar initializing..."
        exec java -Xmx4096m -jar "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" "$@"
    fi
fi
