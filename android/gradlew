#!/bin/sh
#
# Gradle wrapper script for PocketCore Android build
#
set -e

GRADLE_APP_HOME="$(cd -P -- "$(dirname -- "$0")" && pwd -P)"
APP_HOME="$GRADLE_APP_HOME"
APP_BASE_NAME="$(basename "$0")"

WRAPPER_DIR="$APP_HOME/gradle/wrapper"
CLASSPATH="$WRAPPER_DIR/gradle-wrapper.jar"

# Ensure gradle-wrapper.jar exists; download if missing
if [ ! -f "$CLASSPATH" ]; then
    mkdir -p "$WRAPPER_DIR"
    echo "Downloading Gradle wrapper jar..."
    if command -v curl >/dev/null 2>&1; then
        curl -sLo "$CLASSPATH" https://raw.githubusercontent.com/gradle/gradle/v8.10.2/gradle/wrapper/gradle-wrapper.jar
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$CLASSPATH" https://raw.githubusercontent.com/gradle/gradle/v8.10.2/gradle/wrapper/gradle-wrapper.jar
    fi
fi

exec java -Xmx4096m -jar "$CLASSPATH" "$@"
